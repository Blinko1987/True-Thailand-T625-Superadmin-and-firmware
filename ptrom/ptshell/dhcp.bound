#!/bin/sh
# Sample udhcpc bound script
#--------
IPOE_EMULATOR_INFO=/var/ipoeemuinfo
#-------- CT or CU Flag
#CTCU_flag=`getcfgx /data/tr069_control.conf SPTag` 
#--------
if [ -f $IPOE_EMULATOR_INFO ]
then
	ifconfig $interface $ip $BROADCAST $NETMASK
	cfg_cmd setuci ${IPOE_EMULATOR_INFO} DefaultGateway ${router} 0
	cfg_cmd setuci ${IPOE_EMULATOR_INFO} LocalAddress ${ip} 0
	cfg_cmd setuci ${IPOE_EMULATOR_INFO} Result Success 0
	cfg_cmd setuci ${IPOE_EMULATOR_INFO} subnet $subnet 0
	exit
fi
[ -z "$interface" ] && interface="0"
[ -z "$ip" ] && ip="0"
[ -z "$broadcast" ] && broadcast="0"
[ -z "$subnet" ] && subnet="0"
[ -z "$router" ] && router="0"
[ -z "$dns" ] && dns="0"
[ -z "$domain" ] && domain="0"

#cfg_cmd setuci /var/curPppStatus $tty_device ERROR_NONE

ubus call fh_svcmgr_dhcpc fh_svcmgr_dhcpc_notify "{\"interface\":\"$interface\",\"ip\":\"$ip\",\"broadcast\":\"$broadcast\",\"subnet\":\"$subnet\",\"route\":\"$router\",\"dns\":\"$dns\",\"domain\":\"$domain\"}"

#"$interface" string:"$ip" string:"$broadcast" string:"$subnet" string:"$router" string:"$dns" string:"$domain"

exit 0