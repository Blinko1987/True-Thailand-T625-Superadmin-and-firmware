# Rules for USBmount

KERNEL=="sd*", BUS=="usb", ACTION=="add",    RUN="/usr/share/usbmount/usbmount 'add'  '%s{idVendor}' '%s{idProduct}' '%s{serial}' '%s{bcdDevice}' '%s{manufacturer}' '%s{product}'"
#KERNEL=="sd*", BUS=="usb", ACTION=="add",    RUN="/usr/share/usbmount/usbmount add"
#KERNEL=="ub*", BUS=="usb", ACTION=="add",    RUN="/usr/share/usbmount/usbmount 'add'"
KERNEL=="ttyUSB*", BUS=="usb", ACTION=="add",    RUN="/usr/share/usbmount/usbdonglemount 'add' '%s{idVendor}' '%s{idProduct}' '%s{serial}' '%s{bcdDevice}' '%s{manufacturer}' '%s{product}'"
KERNEL=="ttyACM*", BUS=="usb", ACTION=="add",    RUN="/usr/share/usbmount/usbdonglemount 'add'  '%s{idVendor}' '%s{idProduct}' '%s{serial}' '%s{bcdDevice}' '%s{manufacturer}' '%s{product}'"
KERNEL=="hidraw*", BUS=="usb", ACTION=="add",    RUN="/usr/share/usbmount/usbdonglemount 'add'  '%s{idVendor}' '%s{idProduct}' '%s{serial}' '%s{bcdDevice}' '%s{manufacturer}' '%s{product}'"
#KERNEL=="usb",             ACTION=="remove", RUN="/usr/share/usbmount/usbmount 'remove'"
KERNEL=="sd*",             ACTION=="remove", RUN="/usr/share/usbmount/usbmount 'remove'  '%s{idVendor}' '%s{idProduct}' '%s{serial}' '%s{bcdDevice}' '%s{manufacturer}' '%s{product}'"
#KERNEL=="sd*",             ACTION=="remove", RUN="/usr/share/usbmount/usbmount remove"
#KERNEL=="ub*",             ACTION=="remove", RUN="/usr/share/usbmount/usbmount 'remove'"
KERNEL=="ttyUSB*",         ACTION=="remove", RUN="/usr/share/usbmount/usbdonglemount 'remove'  '%s{idVendor}' '%s{idProduct}' '%s{serial}' '%s{bcdDevice}' '%s{manufacturer}' '%s{product}'"
KERNEL=="ttyACM*",         ACTION=="remove", RUN="/usr/share/usbmount/usbdonglemount 'remove'  '%s{idVendor}' '%s{idProduct}' '%s{serial}' '%s{bcdDevice}' '%s{manufacturer}' '%s{product}'"
KERNEL=="hidraw*",         ACTION=="remove", RUN="/usr/share/usbmount/usbdonglemount 'remove'  '%s{idVendor}' '%s{idProduct}' '%s{serial}' '%s{bcdDevice}' '%s{manufacturer}' '%s{product}'"
BUS=="usb",             ACTION=="remove", RUN="/usr/share/usbmount/usbmount 'remove' '%s{idVendor}' '%s{idProduct}' '%s{serial}' '%s{bcdDevice}' '%s{manufacturer}' '%s{product}'"
